# DevContainer Environment Variables
# Copy this file to .env and fill in your values

# SonarQube (for MCP)
SONARQUBE_URL=
SONARQUBE_TOKEN=

# SMTP Configuration
SIMPLEACCOUNTS_SMTP_HOST=
SIMPLEACCOUNTS_SMTP_PORT=465
SIMPLEACCOUNTS_SMTP_USER=
SIMPLEACCOUNTS_SMTP_PASS=
SIMPLEACCOUNTS_SMTP_AUTH=true
SIMPLEACCOUNTS_SMTP_STARTTLS_ENABLE=false
SIMPLEACCOUNTS_SMTP_SSL_ENABLE=true
