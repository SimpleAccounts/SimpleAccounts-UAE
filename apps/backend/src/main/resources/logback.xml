<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
			</pattern>
		</encoder>
	</appender>
    <if condition='isDefined("LogDir")'> <then>
	<appender name="FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
	<file>${LogDir}/simpleaccounts-api.log</file>
	<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
		<!-- daily rollover -->
		<fileNamePattern>${LogDir}/simpleaccounts-api.%d{yyyy-MM-dd}.log
			</fileNamePattern>
			<maxHistory>60</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
			</pattern>
		</encoder>
	</appender> 
	</then> </if>
	<!-- Hibernate SQL logging (disabled by default, enable for debugging) -->
	<!-- <logger name="org.hibernate.SQL" level="debug" /> -->
	<!-- <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="trace" /> -->
	
	<!-- Spring framework logging -->
	<logger name="org.springframework.web.client" level="error" />
	
	<!-- Application logging -->
	<logger name="com.simpleaccounts.rest.companycontroller" level="info" />
	<logger name="com.simpleaccounts.service" level="info" />

	<!-- Root logging level -->
	<root level="info">
		<if condition='isDefined("LogDir")'>
			<then>
				<appender-ref ref="FILE" />
			</then>
			<else>
				<appender-ref ref="STDOUT" />
			</else>
		</if>
	</root>  
  
</configuration>