<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3
                            http://www.ehcache.org/schema/ehcache-core-3.0.xsd
                            http://www.ehcache.org/v3/jsr107
                            http://www.ehcache.org/schema/ehcache-107-ext-3.0.xsd">

    <!-- Default cache template -->
    <cache-template name="defaultTemplate">
        <expiry>
            <ttl unit="seconds">900</ttl>
        </expiry>
        <heap unit="entries">200</heap>
    </cache-template>

    <!-- Dashboard cache template with shorter TTL -->
    <cache-template name="dashboardTemplate">
        <expiry>
            <ttl unit="seconds">300</ttl>
        </expiry>
        <heap unit="entries">50</heap>
    </cache-template>

    <cache alias="chartOfAccountCategoryCache" uses-template="defaultTemplate">
        <heap unit="entries">200</heap>
    </cache>

    <cache alias="chartOfAccountCategoryListCache" uses-template="defaultTemplate">
        <heap unit="entries">20</heap>
    </cache>

    <cache alias="userCache" uses-template="defaultTemplate">
        <heap unit="entries">20</heap>
    </cache>

    <cache alias="productCache" uses-template="defaultTemplate">
        <heap unit="entries">200</heap>
    </cache>

    <cache alias="vatCategoryCache" uses-template="defaultTemplate">
        <heap unit="entries">100</heap>
    </cache>

    <cache alias="productCategoryCache" uses-template="defaultTemplate">
        <heap unit="entries">100</heap>
    </cache>

    <cache alias="transactionCategoryCache" uses-template="defaultTemplate">
        <heap unit="entries">200</heap>
    </cache>

    <cache alias="dashboardProfitLoss" uses-template="dashboardTemplate"/>

    <cache alias="dashboardCashFlow" uses-template="dashboardTemplate"/>

    <cache alias="dashboardInvoiceChart" uses-template="dashboardTemplate"/>

    <cache alias="dashboardBankChart" uses-template="dashboardTemplate">
        <heap unit="entries">100</heap>
    </cache>

    <cache alias="dashboardBankTotalBalance" uses-template="dashboardTemplate">
        <heap unit="entries">10</heap>
    </cache>

</config>
